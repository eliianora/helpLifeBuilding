# ================================
# SUPABASE (obligatoire)
# ================================
# Dashboard : https://supabase.com/dashboard → Settings → API
# Copiez l'URL du projet et la clé "publishable" (ou anon).

VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Même valeurs côté serveur (TanStack Start / Nitro)
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Clé service role — serveur uniquement, jamais dans le navigateur
SUPABASE_SERVICE_ROLE_KEY=votre-service-role

# ================================
# AUTH
# ================================
# 1. Authentication > Providers > Email : activer
# 2. (optionnel) Google : activer et coller Client ID / Secret
# 3. Redirect URLs : http://localhost:3000/auth/callback
# 4. SQL Editor : exécuter supabase-migration-tanstack.sql
# 5. SQL Editor : exécuter supabase-admin-tanstack.sql
# 6. SQL Editor : exécuter supabase-storage-ebooks.sql
# 7. SQL Editor : exécuter supabase-security-production.sql (accès ebooks verrouillé)
# 8. Premier admin : update public.profiles set role = 'admin' where email = 'vous@email.com';

# ================================
# SITE
# ================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
